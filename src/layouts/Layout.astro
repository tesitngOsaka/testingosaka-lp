---
import { SEO } from "astro-seo";
import Footer from "@/components/footer.astro";
import Navbar from "@/components/navbar/navbar.astro";
import "@fontsource-variable/inter/index.css";
import "@fontsource-variable/bricolage-grotesque/index.css";
import "../styles/global.css";

export interface Props {
  title: string;
}

const siteUrl = Astro.site || Astro.url.origin;
const canonicalURL = new URL(Astro.url.pathname, siteUrl).toString();

const resolvedImageWithDomain = new URL(
  "/testingosakaog.png",
  siteUrl
).toString();

const { title } = Astro.props;

const makeTitle = title
  ? title + " | " + "testingOsaka"
  : "testingOsaka";
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- <link rel="preload" as="image" href={src} alt="Hero" /> -->
    <SEO
      title={makeTitle}
      description="testingOsakaのランディングページ"
      canonical={canonicalURL}
      twitter={{
        creator: "@your_twitter_id", // 実際のTwitterアカウントのIDに変更してください
        site: "@your_twitter_id",    // 実際のTwitterアカウントのIDに変更してください
        card: "summary_large_image",
      }}
      openGraph={{
        basic: {
          url: canonicalURL,
          type: "website",
          title: `testingOsaka`,
          image: resolvedImageWithDomain,
        },
        image: {
          alt: "testingOsaka Homepage Screenshot",
        },
      }}
    />
  </head>
  <body>
    <Navbar />
    <slot />
    <Footer />
    <style is:global>
      /* Improve Page speed */
      /* https://css-tricks.com/almanac/properties/c/content-visibility/ */
      img {
        content-visibility: auto;
      }
    </style>
  </body>
</html>
